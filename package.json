{
  "homepage": "https://astalsi401.github.io/gradient-creator",
  "name": "gradient-creator",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
